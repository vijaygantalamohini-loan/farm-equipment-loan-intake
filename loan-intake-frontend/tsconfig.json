{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "moduleResolution": "Node",
    "resolveJsonModule": true
  },
  "include": [
    "src/utils/**/*.{js,ts}",
    "src/validation/**/*.js",
    "src/services/**/*.js",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "src/**/__tests__/**",
    "src/**/*.test.js",
    "tests/**",
    "src/setupProxy.js"
  ]
}
