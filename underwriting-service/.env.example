# Underwriting Service Configuration

# Server
UNDERWRITING_SERVICE_PORT=7002

# Queue Provider (bullmq or rabbitmq)
QUEUE_PROVIDER=bullmq
UNDERWRITING_QUEUE_NAME=underwriting-jobs

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# RabbitMQ (alternative to BullMQ)
RABBITMQ_URL=amqp://localhost

# Underwriting Service URL (for backend gateway)
UNDERWRITING_SERVICE_URL=http://localhost:7002
